# Each installation needs a unique, stable project name and its own env file.
COMPOSE_PROJECT_NAME=ready2race-club-a
# Replace these with an available release tag (e.g. v1.2.0); use matching versions by default.
BACKEND_VERSION=replace-with-release-tag
FRONTEND_VERSION=replace-with-release-tag
HTTP_PORT=8081

DATABASE_PASSWORD=replace-with-random-database-password
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-random-initial-admin-password
# Keep the pepper stable for the lifetime of this instance, including restores.
SECURITY_PEPPER=replace-with-random-pepper

# SMTP is currently required by the application.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_STRATEGY=SMTP_TLS
SMTP_FROM_ADDRESS=ready2race@example.org
SMTP_FROM_NAME=Ready2Race
# Optional settings (blank optional values are treated as unset):
# SMTP_LOCALHOST=
# SMTP_REPLY=
# WHITELIST_EMAIL_RECEIVER='[".*@example.org"]'
# WebDAV: configure scheme, host, user and password together, or leave all unset.
# WEBDAV_URL_SCHEME=https
# WEBDAV_HOST=webdav.example.org
# WEBDAV_PATH=
# WEBDAV_FOLDER_PATH=Ready2Race
# WEBDAV_AUTH_USER=
# WEBDAV_AUTH_PASSWORD=

# Set absolute public URLs when embedding in a page on another domain.
API_BASE_URL=/api
THEME_URL=/static/theme.json
FONTS_URL=/static/fonts
LOGOS_URL=/static/logos
R2R_LOGO_URL=/r2r_logo.png
# Comma-separated exact origins, without a trailing slash; empty disables production CORS.
CORS_ALLOWED_ORIGINS=

# Optional standalone Caddy example:
PUBLIC_DOMAIN=race.example.org
ACME_EMAIL=admin@example.org
